PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ROOM_CLEANUP_INTERVAL_MS=60000
LOG_LEVEL=info

# Number of trusted reverse-proxy hops (Railway production default: 1)
TRUST_PROXY_HOPS=0

# TURN server configuration (optional — required for restrictive NATs)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
TURN_TTL_SECONDS=86400
